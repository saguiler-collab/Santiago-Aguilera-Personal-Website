{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/content/**",
              "components/controls/**",
              "components/labels/**",
              "components/navigation/**",
              "components/surfaces/**",
              "components/typography/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Newsreader|Karla))/i]",
        "message": "Font not provided by the design system. Available: Newsreader, Karla."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|highlight|positive|ink)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'highlight' | 'positive' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|href|iconLeft|iconRight|fullWidth|disabled|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, href, iconLeft, iconRight, fullWidth, disabled, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|ink|secondary|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'ink' | 'secondary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|onClick|media|eyebrow|title|meta|footer|tone|interactive|padding|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: href, onClick, media, eyebrow, title, meta, footer, tone, interactive, padding, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:card|sunken|ink)$/]",
        "message": "<Card> tone must be one of 'card' | 'sunken' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterSocial'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|href|src|key|ref|className|style|children)$/]",
        "message": "<FooterSocial> doesn't accept that prop. Declared props: id, label, href, src."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|src|size|label|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, src, size, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|variant|label|href|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: size, variant, label, href, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:quiet|outline|solid)$/]",
        "message": "<IconButton> variant must be one of 'quiet' | 'outline' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Mark'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|strokeWidth|color|title|style|key|ref|className|style|children)$/]",
        "message": "<Mark> doesn't accept that prop. Declared props: variant, size, strokeWidth, color, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Mark'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:full|spiral)$/]",
        "message": "<Mark> variant must be one of 'full' | 'spiral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|ratio|kind|caption|placeholder|scrim|overlay|radius|style|key|ref|className|style|children)$/]",
        "message": "<MediaFrame> doesn't accept that prop. Declared props: src, alt, ratio, kind, caption, placeholder, scrim, overlay, radius, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MediaFrame'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:photo|video)$/]",
        "message": "<MediaFrame> kind must be one of 'photo' | 'video'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|href|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: id, label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlaceCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:place|city|country|years|src|active|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<PlaceCard> doesn't accept that prop. Declared props: place, city, country, years, src, active, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlaceCard'] > JSXAttribute[name.name='place'] > Literal[value!=/^(?:mexico|colombia|panama|trinidad|usa)$/]",
        "message": "<PlaceCard> place must be one of 'mexico' | 'colombia' | 'panama' | 'trinidad' | 'usa'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Quote'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|attribution|meta|size|style|key|ref|className|style|children)$/]",
        "message": "<Quote> doesn't accept that prop. Declared props: children, attribution, meta, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Quote'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Quote> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|lede|align|level|size|action|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, title, lede, align, level, size, action, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:start|center)$/]",
        "message": "<SectionHeading> align must be one of 'start' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<SectionHeading> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpiralRule'] > JSXAttribute > JSXIdentifier[name!=/^(?:align|size|tone|style|key|ref|className|style|children)$/]",
        "message": "<SpiralRule> doesn't accept that prop. Declared props: align, size, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpiralRule'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|start|end)$/]",
        "message": "<SpiralRule> align must be one of 'center' | 'start' | 'end'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SpiralRule'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:muted|ink|accent)$/]",
        "message": "<SpiralRule> tone must be one of 'muted' | 'ink' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|prefix|suffix|label|note|align|duration|style|key|ref|className|style|children)$/]",
        "message": "<Stat> doesn't accept that prop. Declared props: value, prefix, suffix, label, note, align, duration, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stat'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:start|center)$/]",
        "message": "<Stat> align must be one of 'start' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:place|selected|onClick|iconLeft|children|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: place, selected, onClick, iconLeft, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='place'] > Literal[value!=/^(?:mexico|colombia|panama|trinidad|usa)$/]",
        "message": "<Tag> place must be one of 'mexico' | 'colombia' | 'panama' | 'trinidad' | 'usa'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimelineItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:year|place|title|where|media|meta|last|active|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<TimelineItem> doesn't accept that prop. Declared props: year, place, title, where, media, meta, last, active, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimelineItem'] > JSXAttribute[name.name='place'] > Literal[value!=/^(?:mexico|colombia|panama|trinidad|usa)$/]",
        "message": "<TimelineItem> place must be one of 'mexico' | 'colombia' | 'panama' | 'trinidad' | 'usa'."
      }
    ]
  },
